# ==========================================
# CareerLens Environment Configuration
# ==========================================

# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database & Cache
DATABASE_URL=postgresql://careerlens:careerlens_secret@localhost:5432/careerlens_db
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_careerlens_2026_change_in_production
JWT_REFRESH_SECRET=super_refresh_jwt_key_careerlens_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email SMTP Settings (For real OTP email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM=CareerLens Verification <your_email@gmail.com>

# Frontend Production API Base URL (For Vercel -> Render connection)
VITE_API_BASE_URL=https://your-api-on-render.onrender.com

# AI Service (FastAPI / Gemini API)
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_gemini_api_key_here

# Match Weight Configuration (defaults matching PRD weights)
WEIGHT_REQUIRED_SKILLS=0.40
WEIGHT_PREFERRED_SKILLS=0.15
WEIGHT_EXPERIENCE=0.15
WEIGHT_ROLE=0.10
WEIGHT_PROJECTS=0.10
WEIGHT_LOCATION=0.05
WEIGHT_EDUCATION=0.05
