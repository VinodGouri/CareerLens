{
  "name": "careerlens",
  "version": "1.0.0",
  "private": true,
  "description": "CareerLens - AI-powered Job Discovery, Career Matching & Skill-Gap Intelligence Platform",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:api": "node apps/api/src/server.js",
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run dev --prefix apps/api\" \"npm run dev --prefix apps/web\"",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "npm run dev --prefix apps/api",
    "build:web": "npm run build --prefix apps/web"
  },
  "keywords": [
    "career",
    "jobs",
    "ai-matching",
    "skill-gap",
    "resume-builder",
    "careerlens"
  ],
  "author": "CareerLens Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
